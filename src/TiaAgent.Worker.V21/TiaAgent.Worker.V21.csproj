<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AssemblyName>TiaAgent.Worker.V21</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Supplies the net48 reference assemblies so the worker builds without a Visual Studio / Developer Pack install. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\TiaAgent.Contracts\TiaAgent.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaPortalV21Dir)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaPortalV21Dir)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateTiaOpennessReferences" BeforeTargets="ResolveReferences">
    <Message Importance="High" Text="TiaAgentBridge V21 Openness references: $(TiaPortalV21Dir)" />
    <Error Condition="!Exists('$(TiaPortalV21Dir)\Siemens.Engineering.Base.dll') or !Exists('$(TiaPortalV21Dir)\Siemens.Engineering.Step7.dll')"
           Text="TIA Portal V21 Openness assemblies not found at '$(TiaPortalV21Dir)'." />
  </Target>
</Project>
